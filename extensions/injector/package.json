{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "injector",
    "version": "1.0.0",
    "author": "Thanh Hoang",
    "editor": ">=3.8.6",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "tsc && node ./scripts/build.js",
        "watch": "node ./scripts/build.js --watch",
        "typecheck": "tsc",
        "test": "node ./tests/run.js",
        "preview": "node ./tests/preview/build.js"
    },
    "description": "i18n:injector.description",
    "main": "./dist/main.js",
    "dependencies": {
        "vue": "^3.1.4",
        "ws": "^8.22.1"
    },
    "devDependencies": {
        "@cocos/creator-types": "^3.8.6",
        "@types/node": "^18.17.1",
        "@types/ws": "^8.18.2",
        "esbuild": "^0.24.2",
        "typescript": "^5.8.2"
    },
    "panels": {
        "default": {
            "title": "Injector Diagnostics",
            "type": "dockable",
            "main": "dist/panels/default",
            "icon": "./static/icon.png",
            "size": {
                "min-width": 420,
                "min-height": 260,
                "width": 960,
                "height": 600
            }
        }
    },
    "contributions": {
        "asset-db": {
            "mount": {
                "path": "./assets",
                "readonly": false
            }
        },
        "menu": [
            {
                "path": "i18n:menu.panel",
                "label": "i18n:injector.menu.diagnostics",
                "message": "open-panel"
            },
            {
                "path": "i18n:menu.extension/Injector",
                "label": "i18n:injector.menu.diagnostics",
                "message": "open-panel"
            }
        ],
        "messages": {
            "open-panel": {
                "methods": ["openPanel"]
            },
            "debug-status": {
                "methods": ["debugStatus"]
            },
            "debug-request": {
                "methods": ["debugRequest"]
            },
            "set-lan": {
                "methods": ["setLan"]
            }
        }
    }
}
